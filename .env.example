# Optional: real social dispatch through Buffer.
# Never prefix server secrets with VITE_. Restart local dev / redeploy after changes.
BUFFER_API_KEY=

# Required only when you want a password gate. The page asks again after every
# full browser reload; the password is never stored in localStorage or a cookie.
SHORTSFACTORY_PASSWORD=

# ----------------------------------------------------------------------------
# Upload host — OnlyFiles (the one shipping route, zero setup)
# ----------------------------------------------------------------------------
# There are no env vars for media hosting. The browser posts rendered videos
# straight to the anonymous, CORS-enabled API at
#   https://api.onlyfiles.com/v1/upload  (expire=0 → kept forever)
# and verifies in the browser that the returned address really serves the video
# bytes before anything is handed to Buffer.
# Limits: 100 MB per file, 500 files / 50 GB per hour, 5,000 / 100 GB per day.
# Docs: https://onlyfiles.com/api
