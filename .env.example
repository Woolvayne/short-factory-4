# Optional: real social dispatch through Buffer.
# Never prefix server secrets with VITE_. Restart local dev / redeploy after changes.
BUFFER_API_KEY=

# Required only when you want a password gate. The page asks again after every
# full browser reload; the password is never stored in localStorage or a cookie.
SHORTSFACTORY_PASSWORD=

# Select the default provider in the dispatch window. The UI can switch between
# all three providers whenever more than one is configured.
# Allowed values: r2, b2, puter
STORAGE_PROVIDER=r2

# -----------------------------------------------------------------------------
# 1) Cloudflare R2 — recommended for high monthly traffic
# -----------------------------------------------------------------------------
# R2 dashboard → bucket → S3 API tokens. R2_PUBLIC_BASE_URL must be a public
# custom domain (recommended) or the bucket's r2.dev URL, without a trailing /.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=https://media.example.com

# -----------------------------------------------------------------------------
# 2) Backblaze B2 — cheap S3-compatible alternative
# -----------------------------------------------------------------------------
# B2 bucket must be public (or served through a public CDN/custom domain).
# B2_S3_ENDPOINT looks like https://s3.eu-central-003.backblazeb2.com.
# B2_S3_REGION can be omitted; the app derives it from the endpoint.
B2_S3_ENDPOINT=
B2_S3_REGION=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_PUBLIC_BASE_URL=https://f000.backblazeb2.com/file/my-public-bucket

# -----------------------------------------------------------------------------
# 3) Puter.js — browser-only option, no provider env vars
# -----------------------------------------------------------------------------
# Leave the R2/B2 variables empty when using Puter. The browser loads
# https://js.puter.com/v2/, signs the user into Puter on first upload, writes the
# Blob with puter.fs.write(), and passes Buffer the read URL from getReadURL().
# Puter is user-pays; it has no server-side key to configure here.
