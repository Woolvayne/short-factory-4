# Rendering, local asset storage and the Edge TTS relay need no API key.
# Optional: enable real social dispatch through Buffer.
# Set in .env.local for development or Vercel's server environment, then restart/redeploy.
# NEVER prefix this key with VITE_ or paste it into the frontend.
BUFFER_API_KEY=

# Optional but recommended: the one-time-configured upload host ("middle way").
# Any S3-compatible bucket with public read access works — Cloudflare R2,
# Backblaze B2, AWS S3 or MinIO. Once set, the app uploads every finished render
# straight to the bucket and Buffer receives the permanent public link —
# no manual link entry. The bucket must allow PUT/GET/HEAD from the app origin
# via a CORS rule (see README → "Upload-Host").
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# S3_REGION=auto                                  # R2: auto · AWS: e.g. eu-central-1 · B2: e.g. us-west-004
# S3_ENDPOINT=                                    # R2: https://<accountid>.r2.cloudflarestorage.com · B2: https://s3.<region>.backblazeb2.com · AWS: leave empty
# S3_PUBLIC_BASE_URL=                             # R2: https://pub-<hash>.r2.dev or a custom domain · AWS/B2: derived automatically

# Without an upload host you can still paste permanent public video links per video.
# Protect the deployment with authentication (see README); this is a private operator app.
# Qwen/Mistral keys remain optional and are configured in Machine Settings.
